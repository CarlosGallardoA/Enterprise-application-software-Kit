root = true

# UTF-8 sin BOM y LF en todo el repositorio; solo los scripts de cmd.exe exigen CRLF.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{cs,java,kt,py,rs}]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf
